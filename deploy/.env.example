# Configurazione di un'istanza ShareBox: deploy/.env, leggibile solo da root, mai nel repository.
# deploy/install.sh la crea facendo le domande; questo file elenca i valori.

# IP pubblico del server: Caddy pubblica le porte 80/443 solo su questo indirizzo
PUBLIC_IP=
# Dominio della piattaforma (login, dashboard, API): un record A verso il server
PLATFORM_DOMAIN=sharebox.example.com
# Dominio dei tool: sottodominio DuckDNS (certificato wildcard via DNS-01, vedi ADR 0002)
TOOLS_DOMAIN=nome.duckdns.org
DUCKDNS_TOKEN=
# Client OAuth "Applicazione web" di Google, redirect URI https://<PLATFORM_DOMAIN>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chi può pubblicare tool (ADR 0006), separati da virgola
CREATOR_EMAILS=tu@example.com
# Token interno piattaforma ↔ orchestratore: openssl rand -hex 32
ORCHESTRATOR_TOKEN=
# Chi gestisce l'istanza, per l'informativa privacy (deploy/site/privacy.html)
OPERATOR_NAME=Nome Cognome
OPERATOR_EMAIL=tu@example.com
# Dove sta il server, frase completa per l'informativa privacy
HOSTING_DESCRIPTION=Su un server di Esempio GmbH in Germania, quindi nell'Unione Europea
# google-drive se è configurata la copia cifrata dei backup (deploy/backup/configura-drive.sh), altrimenti nessuno
OFFSITE_BACKUP=nessuno
# Cartella dell'installazione (radice del repository sul server)
SHAREBOX_DIR=/opt/sharebox
