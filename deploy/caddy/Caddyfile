# Certificato wildcard dei tool con la verifica DNS-01: provider scelto con DNS_PROVIDER (duckdns o cloudflare).
(tls-duckdns) {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}
}

(tls-cloudflare) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}
}

*.{$TOOLS_DOMAIN} {
	import tls-{$DNS_PROVIDER}
	encode zstd gzip
	reverse_proxy platform:8080
}

# Piattaforma: login, dashboard e API al processo platform, il resto sono le pagine statiche (home, privacy).
{$PLATFORM_DOMAIN} {
	encode zstd gzip
	handle /auth/* {
		reverse_proxy platform:8080
	}
	handle /app* {
		reverse_proxy platform:8080
	}
	handle /cli/* {
		reverse_proxy platform:8080
	}
	handle /api/* {
		request_body {
			max_size 40MB
		}
		reverse_proxy platform:8080
	}
	handle {
		root * /srv/site
		try_files {path} {path}.html
		# Le pagine sono modelli: titolare, contatto e hosting arrivano da deploy/.env,
		# la lingua da Accept-Language (da qui il Vary, per le cache).
		header Vary Accept-Language
		templates
		file_server
	}
}
