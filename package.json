{
  "name": "sharebox",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/gateway && tsc -p packages/runtime && tsc -p packages/orchestrator && tsc -p packages/platform && tsc -p packages/cli",
    "build": "npm run build:runtime && npm run build:platform && npm run build:orchestrator && npm run build:cli",
    "build:runtime": "esbuild packages/runtime/src/entry.ts --bundle --format=esm --target=es2022 --external:cloudflare:workers --external:./user.js --outfile=deploy/platform/runtime-entry.js",
    "build:platform": "esbuild packages/platform/src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=deploy/platform/platform.mjs && node -e \"require('fs').cpSync('packages/platform/dashboard', 'deploy/platform/dashboard', { recursive: true })\"",
    "build:orchestrator": "esbuild packages/orchestrator/src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=deploy/orchestrator/orchestrator.mjs",
    "build:cli": "esbuild packages/cli/src/bin.ts --bundle --platform=node --target=node20 --format=esm --external:esbuild \"--banner:js=#!/usr/bin/env node\" --outfile=packages/cli/dist/sharebox.mjs",
    "dev:dashboard": "esbuild packages/platform/dev/preview.ts --bundle --platform=node --target=node24 --format=esm --outfile=node_modules/.cache/sharebox/preview.mjs --log-level=warning && node node_modules/.cache/sharebox/preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
